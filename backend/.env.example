# -------------------------------------------------------------------------
# Copiar este archivo como .env y ajustar los valores segun el entorno.
# -------------------------------------------------------------------------

# Seguridad
SECRET_KEY=cambiar-esta-clave-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: "sqlite" para desarrollo, "postgres" para produccion
DB_ENGINE=sqlite
DB_NAME=biometrico
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Zona horaria
TIME_ZONE=America/Lima

# Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Celery / Redis. Poner CELERY_TASK_ALWAYS_EAGER=True para trabajar sin Redis.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# Dispositivo biometrico ZKTeco MB560-VL
ZK_DEVICE_IP=192.168.18.202
ZK_DEVICE_PORT=4370
ZK_DEVICE_TIMEOUT=10
ZK_DEVICE_PASSWORD=0
ZK_FORCE_UDP=False
ZK_ADMIN_USER_ID=6999383

# Solo aplica en produccion (DEBUG=False). Poner False si el sistema corre
# en HTTP dentro de la LAN, sin certificado TLS.
USAR_HTTPS=True
